<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_history_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="6dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:textColor="@color/on_surface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/itemMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/on_surface_dim"
            android:textSize="11sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/itemShare"
        style="@style/Widget.QRSuite.IconButton"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="@string/share"
        app:icon="@drawable/ic_share"
        app:iconSize="17dp"
        app:iconTint="@color/on_surface_dim" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/itemDelete"
        style="@style/Widget.QRSuite.IconButton"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="2dp"
        android:contentDescription="@string/clear_history"
        app:icon="@drawable/ic_delete"
        app:iconSize="17dp"
        app:iconTint="@color/on_surface_dim" />

</LinearLayout>
